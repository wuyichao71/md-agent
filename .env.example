# PyMOL executable — leave unset to use "pymol" from PATH
# PYMOL_CMD=pymol
# PYMOL_CMD=C:\ProgramData\Anaconda3\envs\pymol\Scripts\pymol.exe
# PYMOL_CMD=conda run -n work pymol

# ChimeraX executable — leave unset to use "chimerax" from PATH
# CHIMERAX_CMD=chimerax
# CHIMERAX_CMD=C:\Program Files\ChimeraX\bin\ChimeraX.exe
# CHIMERAX_CMD=conda run -n chimerax ChimeraX

# VMD executable — leave unset to use "vmd" from PATH
# VMD_CMD=vmd
# VMD_CMD=C:\Program Files\University of Illinois\VMD\vmd.exe
# VMD_CMD=conda run -n vmd vmd
